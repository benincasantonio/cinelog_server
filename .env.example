# Server Configuration
# ENVIRONMENT=development
# PORT=8000

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://cinelog:cinelog@localhost:5432/cinelog_db

# CORS Configuration
# CORS_ORIGINS=https://cinelog.app,https://www.cinelog.app
# Auth Configuration
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_SECRET_KEY
RATE_LIMIT_HMAC_SECRET=CHANGE_THIS_IN_PRODUCTION_RATE_LIMIT_SECRET
REGISTRATION_VERIFICATION_HMAC_SECRET=CHANGE_THIS_IN_PRODUCTION_REGISTRATION_VERIFICATION_SECRET
CURSOR_PAGINATION_HMAC_SECRET=CHANGE_THIS_IN_PRODUCTION_CURSOR_PAGINATION_HMAC_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration
# Email Configuration (Dev: Mailpit)
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cinelog.app
# SMTP_USE_SSL=false
# SMTP_TIMEOUT_SECONDS=10
# EMAIL_TRANSPORT selects the outbound message worker's transport: "smtp" (default) or
# "console" (prints instead of sending — useful for local dev without Mailpit). The
# worker refuses to start when neither is usable (EMAIL_TRANSPORT=smtp and SMTP_SERVER unset).
# EMAIL_TRANSPORT=smtp

# Outbound Message Worker Configuration (durable email outbox — see `make run-email-worker`)
# OUTBOUND_MESSAGE_BATCH_SIZE=10
# OUTBOUND_MESSAGE_POLL_INTERVAL_SECONDS=5
# OUTBOUND_MESSAGE_LOCK_TIMEOUT_SECONDS=300
# OUTBOUND_MESSAGE_MAX_ATTEMPTS=5
# OUTBOUND_MESSAGE_RETRY_BASE_SECONDS=60
# OUTBOUND_MESSAGE_RETRY_MAX_SECONDS=3600
# OUTBOUND_MESSAGE_DELIVERED_RETENTION_DAYS=30
# OUTBOUND_MESSAGE_FAILED_RETENTION_DAYS=90

# Redis Configuration (required — used for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0
# REDIS_DEFAULT_TTL=300
# LOG_CACHE_TTL=86400
# STATS_CACHE_TTL=259200

# TMDB Configuration
TMDB_API_KEY=your_tmdb_api_key_here
# TMDB_TIMEOUT=10
# TMDB_SEARCH_CACHE_TTL=600
# TMDB_DETAILS_CACHE_TTL=86400
